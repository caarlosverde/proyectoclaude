{
  "name": "facturo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Facturo — generador de facturas y presupuestos para autónomos y freelancers",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && node scripts/prerender.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "build:embed": "node scripts/build-embed.mjs",
    "build:pages": "tsc -b && BASE_PATH=/proyectoclaude/ VITE_SITE_URL=https://caarlosverde.github.io/proyectoclaude node scripts/prerender.mjs",
    "build:spa": "tsc -b && vite build"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
